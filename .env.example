# ==============================================================================
# EntrenoApp · Variables de Entorno y Configuración de Servicios
# ==============================================================================

# URL Pública de la Aplicación (para webhooks y redirecciones push)
APP_URL=https://entrenoapp-blond.vercel.app

# ------------------------------------------------------------------------------
# 1. SUUNTO CLOUD API (Ingesta Automática de Entrenamientos)
# Portal: https://apizone.suunto.com
# ------------------------------------------------------------------------------
# Client ID de tu aplicación registrada en Suunto Developer Portal
SUUNTO_CLIENT_ID=tu_suunto_client_id_aqui
# Client Secret / Clave secreta OAuth2
SUUNTO_SECRET=tu_suunto_client_secret_aqui
# Subscription Key de Suunto Cloud API (Ocp-Apim-Subscription-Key)
SUUNTO_SUBSCRIPTION_KEY=tu_suunto_subscription_key_aqui
# Secreto opcional para validación de firma de webhooks entrantes
SUUNTO_WEBHOOK_SECRET=tu_secreto_aleatorio_para_verificar_webhook

# ------------------------------------------------------------------------------
# 2. WEB PUSH NOTIFICATIONS (VAPID Multiplataforma - PC y Móvil)
# Generadas con: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
# Clave pública compartida con el cliente PWA / navegador
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BOx1ac511zwztHHh31y6xFvakaLXiQ0OqSjQKrsIlbTq-DiBfRcMaajkZO-XuibMPKwJjgQlKVDXu3Ss6Q5Rpog
# Clave privada conservada únicamente en el servidor
VAPID_PRIVATE_KEY=gzNTC_PTl2XjDYmKOKtOVnw-bid3kqgWVQUgPmqqzpY
# Asunto / contacto para el protocolo Web Push (mailto:correo@dominio.com o url)
VAPID_SUBJECT=mailto:danielespinosa@entrenoapp.es

# ------------------------------------------------------------------------------
# 3. ZEPP / AMAZFIT (Ingesta de Recuperación y Sueño)
# ------------------------------------------------------------------------------
# Credenciales de la cuenta Huami / Zepp
ZEPP_EMAIL=tu_email_zepp@ejemplo.com
ZEPP_PASSWORD=tu_password_zepp
# Opcional: Token directo de sesión si se utiliza ZeppBridge o token extraído
ZEPP_TOKEN=

# ------------------------------------------------------------------------------
# 4. PERSISTENCIA Y CLOUD STORAGE (Opcional en Vercel)
# ------------------------------------------------------------------------------
# Vercel Blob Token para snapshot remoto de entrenoapp.db
# BLOB_READ_WRITE_TOKEN=
